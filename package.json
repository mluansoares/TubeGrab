{
  "name": "tubegrab",
  "version": "1.0.0",
  "private": true,
  "description": "Baixe vídeos e áudios do YouTube por link — app local, interface moderna.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup": "node scripts/setup-bin.mjs",
    "update:ytdlp": "node scripts/setup-bin.mjs --ytdlp-only",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.3.0"
  }
}

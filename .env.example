# Porta e interface (127.0.0.1 = só esta máquina; 0.0.0.0 = rede interna)
PORT=3100
HOST=127.0.0.1

# Opcional: protege a API com um token quando exposto na rede interna
ACCESS_TOKEN=

# Limites de uso (MAX_DURATION_MIN=0 = qualquer duração)
MAX_DURATION_MIN=0
MAX_FILESIZE_MB=4096
CONCURRENCY=1

# Dias até os arquivos serem apagados automaticamente
RETENTION_DAYS=7

# Opcional: cookies, só se o YouTube pedir verificação ("confirme que você não é um robô")
# Mais fácil: deixe o yt-dlp ler os cookies direto do seu navegador (feche o navegador antes).
# Valores: edge, chrome, firefox, brave, opera, vivaldi… (aceita "chrome:Profile 1")
# COOKIES_FROM_BROWSER=edge
# Alternativa: arquivo exportado (extensão "Get cookies.txt LOCALLY")
# COOKIES_FILE=./cookies.txt
